<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
:root{
  --bg:#455762; --surface:#5a7382; --surface2:#526b7a; --input:#415764; --border:#1b252b;
  --text:#f8fafc; --muted:#e2e8f0; --accent:#38bdf8; --radius:5px;
  --req:#f59e0b; --cov:#38bdf8; --ok:#10b981; --claim:#a78bfa;
}
*,*::before,*::after{box-sizing:border-box;border-color:var(--border)}
html{scroll-behavior:smooth}
body{
  background-color:#3d4d57;color:var(--text);font-family:'Inter',sans-serif;min-height:100vh;
  background-image:radial-gradient(at 0% 0%,rgba(56,189,248,.07) 0,transparent 50%),radial-gradient(at 100% 100%,rgba(99,102,241,.05) 0,transparent 50%),radial-gradient(rgba(56,189,248,.08) 1px,transparent 1px);
  background-size:auto,auto,24px 24px;background-attachment:fixed;
}
button,input,select,textarea,.r{border-radius:var(--radius)}
.mono{font-family:'JetBrains Mono',monospace}
.card{
  background:rgba(90,115,130,.65);backdrop-filter:blur(16px) saturate(170%);-webkit-backdrop-filter:blur(16px) saturate(170%);
  border:1.5px solid var(--border);border-radius:var(--radius);
  box-shadow:0 16px 36px -8px rgba(0,0,0,.45),0 4px 12px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.24);
}
.inp{
  width:100%;background:rgba(65,87,100,.75);border:1.5px solid var(--border);color:#fff;padding:.55rem .75rem;
  font-family:'JetBrains Mono',monospace;font-size:.8125rem;outline:none;
  box-shadow:inset 0 1px 2px rgba(0,0,0,.3),inset 0 1px 0 rgba(255,255,255,.2);
}
.inp:focus{border-color:#fff;box-shadow:0 0 0 1px #fff}
.inp::placeholder{color:#cbd5e1;opacity:.8}
select.inp option{background:#526b7a;color:#fff}
.lbl{display:block;font-family:'JetBrains Mono',monospace;font-size:.6875rem;font-weight:600;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin-bottom:.3rem}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:600;
  padding:.5rem .85rem;background:rgba(90,115,130,.8);border:1px solid var(--border);color:#fff;cursor:pointer;
  box-shadow:0 4px 10px rgba(0,0,0,.2),inset 0 1px 0 rgba(255,255,255,.24);transition:all .12s;user-select:none;white-space:nowrap
}
.btn:hover{background:rgba(105,130,145,.95);transform:translateY(-1px)}
.btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
.btn-primary{background:#fff;color:#2a373f;border-color:#fff}
.btn-primary:hover{background:#e2e8f0}
.btn-danger:hover{background:#b91c1c;border-color:#7f1d1d}
.chip{display:inline-flex;align-items:center;gap:.35rem;font-family:'JetBrains Mono',monospace;font-size:10px;font-weight:700;padding:.15rem .5rem;border:1px solid var(--border);background:rgba(27,37,43,.45);text-transform:uppercase;letter-spacing:.04em}
.tab{padding:.5rem 1rem;font-family:'JetBrains Mono',monospace;font-size:.75rem;font-weight:600;color:var(--muted);cursor:pointer;border:1px solid transparent;background:transparent}
.tab.active{background:#fff;color:#2a373f;border-color:var(--border)}
.tab:not(.active):hover{background:rgba(255,255,255,.1)}
.seg button{opacity:.75}.seg button.on{opacity:1;background:#fff;color:#2a373f}
.modal-bg{position:fixed;inset:0;z-index:60;background:rgba(5,7,14,.8);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:1rem}
.modal-bg.show{display:flex}
.modal{background:rgba(58,78,91,.97);border:1.5px solid var(--border);border-radius:var(--radius);width:100%;max-height:94vh;overflow-y:auto;box-shadow:0 35px 80px -15px rgba(0,0,0,.75),inset 0 1px 1px rgba(255,255,255,.3)}
@keyframes up{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.up{animation:up .25s cubic-bezier(.16,1,.3,1) both}
html,body,*{scrollbar-width:none;-ms-overflow-style:none}
*::-webkit-scrollbar{display:none}
@media (max-width:768px){input,select,textarea{font-size:16px!important}}
.tl-hour{position:absolute;left:0;right:0;border-top:1px dashed rgba(255,255,255,.14)}
.tl-ev{position:absolute;overflow:hidden;padding:.25rem .4rem;border:1.5px solid var(--border);cursor:pointer;font-size:11px;line-height:1.25;box-shadow:0 4px 10px rgba(0,0,0,.3)}
.tl-ev:hover{z-index:5;filter:brightness(1.12)}
.now-line{position:absolute;left:0;right:0;border-top:2px solid #ef4444;z-index:6}
.now-line::before{content:'NOW';position:absolute;left:0;top:-9px;background:#ef4444;color:#fff;font:700 9px 'JetBrains Mono',monospace;padding:0 4px;border-radius:3px}
select,input[type=date],input[type=time]{color-scheme:dark}
</style>
</head>
<body class="flex flex-col">

<!-- Header -->
<header class="sticky top-0 z-40" style="background:rgba(69,87,98,.9);backdrop-filter:blur(16px);border-bottom:2px solid var(--border)">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <div class="w-9 h-9 r flex items-center justify-center shrink-0" style="background:rgba(27,37,43,.5);border:1px solid var(--border)"><i class="fa-solid fa-camera"></i></div>
      <div class="min-w-0">
        <div class="font-bold text-sm leading-tight truncate">Yearbook Photo Board</div>
        <div class="mono text-[10px] text-slate-200 leading-tight"><span id="conn-dot" class="inline-block w-2 h-2 rounded-full bg-amber-400 mr-1"></span><span id="conn-text">Connecting…</span></div>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <div id="user-box" class="hidden items-center gap-2">
        <span class="chip hidden sm:inline-flex"><i class="fa-solid fa-user"></i><span id="user-name"></span></span>
        <button id="logout-btn" class="btn"><i class="fa-solid fa-right-from-bracket"></i><span class="hidden md:inline">Log Out</span></button>
      </div>
    </div>
  </div>
</header>

<!-- Auth screen -->
<main id="auth-view" class="flex-1 flex items-center justify-center px-4 py-10">
  <div class="card w-full max-w-sm p-6 up">
    <div class="text-center mb-5">
      <div class="w-12 h-12 mx-auto r flex items-center justify-center text-xl mb-3" style="background:rgba(27,37,43,.5);border:1px solid var(--border)"><i class="fa-solid fa-camera-retro"></i></div>
      <h1 class="text-lg font-bold">Yearbook Photo Board</h1>
      <p class="text-xs text-slate-200 mt-1">Request photos, post what you're covering, and see the whole schedule.</p>
    </div>
    <div class="seg flex gap-1 p-1 mb-4 r" style="background:rgba(27,37,43,.45);border:1px solid var(--border)">
      <button id="mode-login" class="tab flex-1 active">Log In</button>
      <button id="mode-signup" class="tab flex-1">Sign Up</button>
    </div>
    <form id="auth-form" class="space-y-3" autocomplete="on">
      <div><label class="lbl" for="a-user">Username</label><input id="a-user" class="inp" autocomplete="username" maxlength="20" placeholder="e.g. jsmith" required></div>
      <div><label class="lbl" for="a-pass">Password</label><input id="a-pass" type="password" class="inp" autocomplete="current-password" placeholder="••••••" required></div>
      <div id="confirm-wrap" class="hidden"><label class="lbl" for="a-pass2">Confirm Password</label><input id="a-pass2" type="password" class="inp" autocomplete="new-password" placeholder="••••••"></div>
      <div id="auth-err" class="hidden mono text-[11px] text-red-300 bg-red-500/10 border border-red-500/40 r px-3 py-2"></div>
      <button id="auth-submit" class="btn btn-primary w-full py-2.5">Log In</button>
    </form>
    <p class="mono text-[10px] text-slate-200 text-center mt-4">No email needed. Just pick a username and password.</p>
  </div>
</main>

<!-- App -->
<main id="app-view" class="hidden flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 py-5 flex-col gap-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="seg flex gap-1 p-1 r" style="background:rgba(27,37,43,.45);border:1px solid var(--border)">
      <button class="tab active" data-tab="board"><i class="fa-solid fa-list-check mr-1.5"></i>Board</button>
      <button class="tab" data-tab="dash"><i class="fa-solid fa-calendar-day mr-1.5"></i>Schedule Dash</button>
      <button class="tab" data-tab="mine"><i class="fa-solid fa-user-pen mr-1.5"></i>My Posts</button>
    </div>
    <div class="flex gap-2">
      <button class="btn btn-primary" data-new="request"><i class="fa-solid fa-hand"></i>Need a Photo</button>
      <button class="btn" data-new="covering"><i class="fa-solid fa-camera"></i>I'm Covering</button>
    </div>
  </div>

  <!-- Board -->
  <section id="tab-board" class="flex flex-col gap-4">
    <div class="card p-3.5 grid grid-cols-2 lg:grid-cols-4 gap-2 mono text-xs">
      <div class="relative col-span-2 lg:col-span-1"><i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-xs"></i><input id="f-search" class="inp" style="padding-left:2rem" placeholder="Search posts…"></div>
      <select id="f-type" class="inp"><option value="">All Types</option><option value="request">Photo Requests</option><option value="covering">Self-Covered</option></select>
      <select id="f-status" class="inp"><option value="">All Statuses</option><option value="open">Open / Planned</option><option value="claimed">Claimed</option><option value="done">Done</option></select>
      <select id="f-when" class="inp"><option value="upcoming">Today &amp; Upcoming</option><option value="today">Today Only</option><option value="past">Past</option><option value="all">All Dates</option></select>
    </div>
    <div class="mono text-xs text-slate-100 px-1" id="board-count"></div>
    <div id="board-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"></div>
  </section>

  <!-- Dash -->
  <section id="tab-dash" class="hidden flex-col gap-4">
    <div class="card p-3.5 flex flex-wrap items-center gap-2">
      <button id="d-prev" class="btn"><i class="fa-solid fa-chevron-left"></i></button>
      <input id="d-date" type="date" class="inp" style="width:auto">
      <button id="d-next" class="btn"><i class="fa-solid fa-chevron-right"></i></button>
      <button id="d-today" class="btn">Today</button>
      <div id="d-label" class="mono text-xs ml-auto text-slate-100"></div>
    </div>
    <div id="d-stats" class="grid grid-cols-2 lg:grid-cols-4 gap-3"></div>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="card p-4 lg:col-span-2">
        <div class="flex items-center justify-between mb-3">
          <h2 class="font-bold text-sm">Day Timeline</h2>
          <div class="flex gap-3 mono text-[10px]">
            <span><i class="fa-solid fa-square" style="color:var(--req)"></i> Request</span>
            <span><i class="fa-solid fa-square" style="color:var(--claim)"></i> Claimed</span>
            <span><i class="fa-solid fa-square" style="color:var(--cov)"></i> Covering</span>
            <span><i class="fa-solid fa-square" style="color:var(--ok)"></i> Done</span>
          </div>
        </div>
        <div id="d-timeline" class="relative"></div>
      </div>
      <div class="flex flex-col gap-4">
        <div class="card p-4"><h2 class="font-bold text-sm mb-3"><i class="fa-solid fa-triangle-exclamation text-amber-300 mr-1.5"></i>Needs a Photographer</h2><div id="d-unclaimed" class="flex flex-col gap-2"></div></div>
        <div class="card p-4"><h2 class="font-bold text-sm mb-3"><i class="fa-solid fa-forward text-sky-300 mr-1.5"></i>Next 7 Days</h2><div id="d-week" class="flex flex-col gap-1.5"></div></div>
      </div>
    </div>
  </section>

  <!-- Mine -->
  <section id="tab-mine" class="hidden flex-col gap-4">
    <div class="mono text-xs text-slate-100 px-1" id="mine-count"></div>
    <div id="mine-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-3"></div>
  </section>
</main>

<footer class="mt-8 py-6 text-center text-xs mono text-slate-300" style="border-top:1px solid var(--border);background:rgba(69,87,98,.6)">
  &copy; 2026 Aperture. All rights reserved.
</footer>

<!-- Post modal -->
<div id="post-modal" class="modal-bg"><div class="modal max-w-lg">
