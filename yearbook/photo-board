      <button type="button" id="pt-request" class="tab flex-1 on"><i class="fa-solid fa-hand mr-1"></i>I Need a Photo</button>
      <button type="button" id="pt-covering" class="tab flex-1"><i class="fa-solid fa-camera mr-1"></i>I'm Covering It</button>
    </div>
    <div><label class="lbl" for="p-title" id="p-title-lbl">What do you need photographed?</label><input id="p-title" class="inp" maxlength="80" required></div>
    <div><label class="lbl" for="p-loc">Where</label><input id="p-loc" class="inp" maxlength="80" placeholder="Room, field, gym, etc." required></div>
    <div class="grid grid-cols-3 gap-2">
      <div class="col-span-3 sm:col-span-1"><label class="lbl" for="p-date">Date</label><input id="p-date" type="date" class="inp" required></div>
